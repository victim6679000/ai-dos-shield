# ============================================================
# Copy to .env before running.  cp .env.example .env
# Every tunable value lives here. No magic numbers in the code.
# ============================================================

# ---- Inference server --------------------------------------
# true  = timing simulation, no model download. Use on day 1.
# false = real Hugging Face model.
MOCK_MODEL=true
MODEL_NAME=google/flan-t5-small
INFER_WORKERS=2          # model worker threads == the capacity we protect
TORCH_THREADS=2          # keep small on a laptop; keeps runs reproducible
MAX_NEW_TOKENS_CAP=256
MAX_TEXT_CHARS=8000
MAX_INPUT_TOKENS=512
MODEL_WARMUP_REQUESTS=3
METRICS_WINDOW_SIZE=200

# Mock timing model. Overwrite with your own measured numbers from
# analysis/calibrate.py so the simulation matches your laptop.
MOCK_BASE_MS=60
MOCK_MS_PER_OUT_TOKEN=18
MOCK_MS_PER_IN_TOKEN=0.8
MOCK_JITTER=0.10
MOCK_CHARS_PER_TOKEN=4.0

# ---- Cost model (from analysis/calibrate.py) ----------------
COST_C0=60
COST_C_IN=0.8
COST_C_OUT=18
COST_MAX_MS=20000

# ---- Shield: capacity ---------------------------------------
MITIGATION_ENABLED=true  # false = pass-through proxy (control experiment)
MAX_ACTIVE=4             # concurrent requests allowed into the model
MAX_WAITING=8            # bounded queue; overflow gets a fast 503
PROTECTION_MAX_WAITING=4 # smaller queue once protection engages

# ---- Shield: per-client budget ------------------------------
BUCKET_CAPACITY_MS=4000      # burst allowance, in estimated model ms
BUCKET_REFILL_MS_PER_S=700   # sustained allowance, ms of compute per second
NEW_CLIENT_FILL=0.35         # unknown client IDs start partly filled (anti-Sybil)
MAX_INFLIGHT_PER_CLIENT=2    # closed-loop users never need more than this
SHED_GRACE=0.45              # budget-priority shedding aggressiveness

# ---- Shield: protection mode --------------------------------
PROTECTION_REFILL_SCALE=0.6
PROTECTION_CAPACITY_SCALE=0.6
PROTECTION_COST_MULTIPLIER=1.0
PROTECTION_INFLIGHT_SCALE=0.5

# ---- Auto-mitigation controller -----------------------------
CTRL_ENTER_OCC=0.70      # enter PROTECTION above this queue occupancy
CTRL_EXIT_OCC=0.30       # leave below this  (hysteresis gap prevents flapping)
CTRL_ENTER_P95_MS=4000
CTRL_EXIT_P95_MS=1500
CTRL_ENTER_CHECKS=3      # consecutive checks required to enter
CTRL_EXIT_CHECKS=6       # more checks to leave than to enter
CTRL_INTERVAL_S=1.0

# ---- Upstream ------------------------------------------------
UPSTREAM_CONNECT_TIMEOUT=3.0
UPSTREAM_READ_TIMEOUT=60.0
